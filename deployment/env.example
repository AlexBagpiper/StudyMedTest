# --- Deployment Settings ---
DOMAIN_NAME=med-testing.ru
MAIL_DOMAIN_NAME=mail.med-testing.ru
CERTBOT_EMAIL=admin@med-testing.ru

# --- General Settings ---
PROJECT_NAME=MedTest Platform
ENVIRONMENT=production
VERSION=1.4.3

# --- Database Configuration ---
POSTGRES_SERVER=db
POSTGRES_USER=medtest_user
POSTGRES_PASSWORD=secure_password_change_me
POSTGRES_DB=medtest_db
DATABASE_URL=postgresql+asyncpg://medtest_user:secure_password_change_me@db:5432/medtest_db

# --- Redis & Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Security ---
SECRET_KEY=generate_a_random_string_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Object Storage (MinIO) ---
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_password_change_me
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_password_change_me
MINIO_BUCKET=medtest-storage
MINIO_SECURE=False
MINIO_PUBLIC_URL=/storage

# --- Email ---
SMTP_HOST=mail
SMTP_PORT=465
SMTP_USER=account@med-testing.ru
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=account@med-testing.ru
EMAIL_TRANSPORT=celery
# Исходящий OTP в РФ: Яндекс 360 SMTPS 465 (не HTTP, не прямой MX :25 с VM YC).
#   SMTP_RELAY_HOST=smtp.yandex.ru
#   SMTP_RELAY_PORT=465
#   SMTP_RELAY_USER=noreply@med-testing.ru
#   SMTP_RELAY_PASSWORD=<пароль приложения Яндекс 360>
# SPF: v=spf1 mx a:mail.med-testing.ru include:_spf.yandex.net ~all
SMTP_RELAY_HOST=
SMTP_RELAY_PORT=465
SMTP_RELAY_USER=
SMTP_RELAY_PASSWORD=
# true = Yandex Cloud (Gmail/Mail.ru need SMTP_RELAY_*). Reg.ru + mox: false or omit.
SMTP_REQUIRE_RELAY=false

# --- Initial Admin User ---
FIRST_ADMIN_EMAIL=admin@med-testing.ru
FIRST_ADMIN_PASSWORD=admin123_change_me

# --- Frontend ---
VITE_API_URL=/api/v1
